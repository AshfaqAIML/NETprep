# =============================================================================
# NETPrep Hub — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` (or `.env.local`) and fill in the values.
#   cp .env.example .env
#
# Every variable below is OPTIONAL unless explicitly marked REQUIRED.
# The application runs with sensible defaults for local development.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public URL of the deployed application (used for SEO, emails, CORS).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment (development | production).
NODE_ENV=development

# Port the Next.js dev/prod server listens on.
PORT=3000

# -----------------------------------------------------------------------------
# Database (REQUIRED for the app to function)
# -----------------------------------------------------------------------------
# PostgreSQL connection string (production / docker).
# Examples:
#   PostgreSQL: postgresql://user:password@localhost:5432/netprep?schema=public
#   Neon:       postgresql://user:password@ep-xxx.neon.tech/netprep?sslmode=require
#   Supabase:   postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
#
# For local development the project ships with SQLite — the default below works
# out of the box with no external database.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Optional: direct connection URL used by Prisma migrate (some providers like
# Neon require a separate non-pooled URL for schema migrations).
DIRECT_URL=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Secret used to sign session cookies / JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Auth provider: "credentials" (email+password), "google", "github", or a combination.
# Leave empty to use the built-in demo authentication.
AUTH_PROVIDER=credentials

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Demo admin credentials (for local development only — DO NOT use in production)
DEMO_ADMIN_EMAIL=admin@netprephub.local
DEMO_ADMIN_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Storage (for book covers, PDFs, images, thumbnails)
# -----------------------------------------------------------------------------
# Provider: "local" (default) or "s3" (S3-compatible: AWS S3, Cloudflare R2,
# Backblaze B2, MinIO, etc.)
STORAGE_PROVIDER=local

# Local storage directory (only used when STORAGE_PROVIDER=local)
STORAGE_LOCAL_PATH=./public/uploads

# S3-compatible storage (only used when STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Use path-style addressing (true for MinIO / R2, false for AWS S3)
S3_FORCE_PATH_STYLE=false

# -----------------------------------------------------------------------------
# Email (optional — used for password reset, notifications)
# -----------------------------------------------------------------------------
# Provider: "smtp" (default), "resend", or "none" (disables email)
EMAIL_PROVIDER=none

# SMTP (only used when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NETPrep Hub <noreply@netprephub.local>"

# Resend (only used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_FROM="NETPrep Hub <noreply@netprephub.local>"

# -----------------------------------------------------------------------------
# Search (optional — defaults to PostgreSQL full-text search)
# -----------------------------------------------------------------------------
# Provider: "postgres" (default), "meilisearch", or "typesense"
SEARCH_PROVIDER=postgres

# Meilisearch (only used when SEARCH_PROVIDER=meilisearch)
MEILISEARCH_URL=
MEILISEARCH_KEY=

# Typesense (only used when SEARCH_PROVIDER=typesense)
TYPESENSE_URL=
TYPESENSE_KEY=

# -----------------------------------------------------------------------------
# AI (optional — the app works fully without AI)
# -----------------------------------------------------------------------------
# Provider: "none" (default), "openai", "anthropic", or "google"
AI_PROVIDER=none

# OpenAI (only used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (only used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google (only used when AI_PROVIDER=google)
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------
# Provider: "none" (default) or "posthog"
ANALYTICS_PROVIDER=none
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Maximum API requests per minute per IP (0 = unlimited)
RATE_LIMIT_PER_MINUTE=120
